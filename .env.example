# App connects as app_user: not a superuser and not the table owner, so RLS applies.
DATABASE_URL=postgres://app_user:app_user@localhost:5432/jyotish
# Migrations and test setup run as the owner.
DATABASE_OWNER_URL=postgres://postgres:postgres@localhost:5432/jyotish
# Tenants live at <slug>.$APP_DOMAIN (dev: http://<slug>.localhost:3000)
APP_DOMAIN=localhost
# Bearer token for POST /admin/tenants. Use a long random value outside dev.
PLATFORM_ADMIN_TOKEN=change-me
# Upstash-compatible REST proxy in front of the docker Redis (serverless-redis-http)
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-token
