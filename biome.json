{
  "files": {
    "includes": [
      "**",
      "!**/drizzle/meta",
      "!**/*.md",
      "!**/.next",
      "!**/.wrangler",
      "!**/next-env.d.ts",
      "!**/.gstack"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "linter": {
    "rules": { "style": { "noNonNullAssertion": "off", "noDescendingSpecificity": "off" } }
  }
}
